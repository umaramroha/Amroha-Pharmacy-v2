new file mode 100644
--- /dev/null
+++ b/src/lib/utils.ts
@@ -0,0 +1,9 @@
+/**
+ * Escape untrusted text before interpolating it into HTML.
+ */
+export function escapeHtml(value: string): string {
+  return value.replace(/[&<>"']/g, (char) => ({
+    "&": "&amp;",
+    "<": "&lt;",
+    ">": "&gt;",
+    '"': "&quot;",
+    "'": "&#39;",
+  })[char] as string);
+}
