generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Decimal
  mrp         Decimal?
  image       String?
  images      String[]   @default([])
  category    String?
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  manufacturer String?
  composition  String?
  usage        String?
  warnings     String?
  batchNumber  String?
  expiryDate   DateTime?
  orderItems  OrderItem[]
  @@index([isActive, category])
  @@index([isActive, createdAt])
}

model Order {
  id             String      @id @default(cuid())
  customerId     String?
  customerName   String
  customerMobile String
  customerEmail  String?
  address        String
  city           String
  state          String
  pincode        String
  subtotal        Decimal     @default(0)
  deliveryFee     Decimal     @default(0)
  zoneDiscount    Decimal     @default(0)
  prepaidDiscount Decimal     @default(0)
  couponCode      String?
  couponDiscount  Decimal     @default(0)
  @@index([couponCode])
  deliveryZone    String?
  total           Decimal
  status         String      @default("PENDING")
  courierName    String?
  trackingNumber String?
  shippedAt      DateTime?
  paymentMethod  String
  paymentStatus  String      @default("PENDING")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  customer       Customer?   @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId, status])
  @@index([customerId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal
  @@index([orderId])
  @@index([productId])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  lastPasswordChange DateTime @default(now())
  createdAt DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  mobile    String?
  password  String
  isVerified              Boolean   @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?
  lastPasswordChange DateTime @default(now())
  createdAt DateTime @default(now())
  followUpAt     DateTime?
  followUpNote   String?
  followUpStatus String?
  orders    Order[]
  @@index([resetToken])
  @@index([verificationToken])
  @@index([followUpStatus, followUpAt])
}


model Banner {
  id        String   @id @default(cuid())
  brand     String
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  theme     String   @default("teal")
  layout    String   @default("split")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model RateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  @@index([resetAt])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String
  value         Decimal
  minCartValue  Decimal   @default(0)
  maxDiscount   Decimal?
  usageLimit    Int?
  perUserLimit  Int?
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  firstOrderOnly Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Record of every email the site tries to send (success or failure)
model NotificationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  event     String
  audience  String   // CUSTOMER or ADMIN
  toEmail   String
  subject   String
  status    String   // SENT or FAILED
  error     String?
  html      String?  // kept only for FAILED emails so they can be re-sent
  orderId   String?

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([orderId])
}
